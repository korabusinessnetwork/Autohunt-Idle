# Client (Vite) — só chave pública/anon entra aqui. Nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canal de distribuição: dominio-proprio (padrão) | crazygames | poki
#
# Vazio ou desconhecido cai em `dominio-proprio`, que não carrega SDK de
# terceiro nenhum. Nos canais de portal, o SDK é injetado pela página que
# hospeda o jogo — o build nunca busca script externo por conta própria
# (a Poki bloqueia request externo por padrão).
VITE_CANAL=

# ---------------------------------------------------------------------------
# Servidor (Edge Functions) — configurado via `supabase secrets set`, nunca aqui.
# Listado só para documentar o que as functions esperam.
#
# AD_PROVIDER          nome do provedor de anúncio ativo. Vazio = nenhum provedor
#                      plugado, e o callback rejeita tudo (estado padrão da Fase 1).
#                      `dev` habilita o adapter de teste local.
# AD_CALLBACK_SECRET   segredo HMAC compartilhado com o provedor de anúncio.
# GATEWAY_PROVIDER     nome do gateway de assinatura ativo (stripe | asaas). Vazio =
#                      nenhum gateway plugado, e o webhook rejeita tudo.
# GATEWAY_WEBHOOK_SECRET  segredo HMAC compartilhado com o gateway.
# ---------------------------------------------------------------------------
